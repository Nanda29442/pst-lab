
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[][] arr = new int[n][n];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                arr[i][j] = sc.nextInt();
            }
        }

        int d1 = 0, d2 = 0;

        for (int i = 0; i < n; i++) {
            d1 += arr[i][i];
            d2 += arr[i][n - 1 - i];
        }

        System.out.println(Math.abs(d1 - d2));
        sc.close();
    }
}

