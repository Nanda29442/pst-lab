import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) return;
        int t = scanner.nextInt();
        
        while (t-- > 0) {
            String s = scanner.next();
            if (isLapindrome(s)) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        
        scanner.close();
    }

    private static boolean isLapindrome(String s) {
        int n = s.length();
        int halfLen = n / 2;
        int[] freq = new int[26];

        for (int i = 0; i < halfLen; i++) {
            // Count frequencies for the first half
            freq[s.charAt(i) - 'a']++;
            
            // Subtract frequencies for the second half (skips middle char if odd)
            freq[s.charAt(n - 1 - i) - 'a']--;
        }

        // Verify all character frequencies net out to zero
        for (int count : freq) {
            if (count != 0) {
                return false;
            }
        }

        return true;
    }
}

Sample input:          
6                       
                         
gaga
abcde
