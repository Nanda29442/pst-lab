import java.time.LocalDate;

class Solution {
    // Approach 1: Manual Day Count (Using anchor date Jan 1, 1971)
    public String dayOfTheWeek(int day, int month, int year) {
        String[] days = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
        int[] daysInMonths = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

        int totalDays = 0;

        // 1. Add days for all full years from 1971 to year - 1
        for (int y = 1971; y < year; y++) {
            totalDays += isLeapYear(y) ? 366 : 365;
        }

        // 2. Add days for all full months in the target year
        for (int m = 1; m < month; m++) {
            if (m == 2 && isLeapYear(year)) {
                totalDays += 29;
            } else {
                totalDays += daysInMonths[m - 1];
            }
        }

        // 3. Add remaining days in current month
        totalDays += day - 1;

        // Jan 1, 1971 was Friday (index 5 in ["Sunday", "Monday", ...])
        return days[(5 + totalDays) % 7];
    }

    private boolean isLeapYear(int year) {
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }
}
